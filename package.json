{
  "name": "agent-air-traffic-control",
  "version": "0.1.0",
  "description": "Real-time coordination infrastructure for coding agents.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "atc": "packages/cli/cli.mjs"
  },
  "files": [
    "packages/cli/*.mjs",
    "packages/daemon/*.mjs",
